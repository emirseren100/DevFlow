# Copy to .env.test. Used only by the automated tests.
#
# DATABASE_URL must point at a disposable database whose name contains
# "devflow_test". The test setup refuses to run otherwise, so a mistyped URL can
# never delete development data.
NODE_ENV=test
CLIENT_ORIGIN=http://localhost:5174
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devflow_test?schema=public
SESSION_COOKIE_NAME=devflow_session
SESSION_TTL_DAYS=7

# Keep the pool small: the local disposable "prisma dev" server drops
# connections past a couple, which corrupts requests that run in parallel.
DATABASE_POOL_MAX=2
