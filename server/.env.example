# Copy to .env for local development.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5174

# Production only. The deployed application is one service on one origin, so
# the trusted origin is resolved as:
#   1. CLIENT_ORIGIN (set it for a custom domain)
#   2. RENDER_EXTERNAL_URL (Render publishes this by itself)
#   3. http://localhost:5174 — outside production only
# Production refuses to start when neither of the first two exists.
#
# SERVE_CLIENT=true also serves the built React client from this process, which
# is the production default. Set CLIENT_DIST_PATH only when that build is not at
# <repo>/client/dist.
# SERVE_CLIENT=false
# CLIENT_DIST_PATH=

# Example development value only. Use your own local PostgreSQL credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devflow?schema=public

# Optional. Only needed when the development database cannot create its own
# shadow database for migrations (for example the local `npx prisma dev` server,
# which prints both URLs when it starts).
# SHADOW_DATABASE_URL=

# Session cookie holding the opaque session token. Only its SHA-256 hash is
# stored in the database, so no secret value belongs in this file.
SESSION_COOKIE_NAME=devflow_session
SESSION_TTL_DAYS=7

# Login and register attempt limit, per client IP. Only those two routes are
# limited; the counter lives in memory and is lost on restart.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Maximum PostgreSQL connections in the pool. The local disposable "prisma dev"
# server drops connections past a couple, which corrupts parallel requests, so
# 2 is the safe value here. A real PostgreSQL server can use 10.
DATABASE_POOL_MAX=2
