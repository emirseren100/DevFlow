{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:auth": "vitest run src/test/auth.test.ts",
    "test:workspaces": "vitest run src/test/workspace.test.ts",
    "test:projects": "vitest run src/test/project.test.ts",
    "test:sprints": "vitest run src/test/sprint.test.ts",
    "test:issues": "vitest run src/test/issue.test.ts",
    "test:comments": "vitest run src/test/comment.test.ts",
    "test:activities": "vitest run src/test/activity.test.ts",
    "test:kanban": "vitest run src/test/kanban.test.ts",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:check": "tsx prisma/check.ts",
    "db:test:prepare": "tsx prisma/prepareTestDb.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^7.9.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
