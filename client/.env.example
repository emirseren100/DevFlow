# Copy to .env for local development.
# Only VITE_ prefixed variables reach the browser bundle, so never put a secret here.
VITE_API_URL=http://localhost:4000/api

# In production the client and the API share one origin, so the production
# image is built with the relative value instead:
#
#   VITE_API_URL=/api
#
# It is set in Dockerfile.production, not here, because Vite inlines the value
# at build time.
