# Copy to .env.docker, then start the stack with:
#
#   docker compose --env-file .env.docker build
#   docker compose --env-file .env.docker up
#
# Docker Compose does not read this file automatically — it reads `.env` — so
# the --env-file flag above is what makes these values apply. Every key already
# has a default inside docker-compose.yml, so a plain `docker compose up` also
# works with the values below.
#
# DEVELOPMENT ONLY. These credentials exist to let a container talk to a
# container on one laptop. They are not production credentials, they are
# committed as an example on purpose, and a deployed database must use secrets
# that never live in a file like this.

# PostgreSQL container
POSTGRES_DB=devflow
POSTGRES_USER=devflow
POSTGRES_PASSWORD=devflow_local_password

# Host port for the database. 5433 keeps an installed PostgreSQL on 5432 free.
# Inside the Compose network the database is always postgres:5432.
POSTGRES_HOST_PORT=5433

# Host ports for the application. 5175 keeps the local Vite server on 5174 free.
SERVER_PORT=4000
CLIENT_PORT=5175

# Session cookie. Only the SHA-256 hash of the token is stored in the database,
# so no secret belongs in this file.
SESSION_COOKIE_NAME=devflow_session
SESSION_TTL_DAYS=7
